# Next.js (.env.local)
# `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL for you.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex deployment. These are NOT read from this file. Set each with `npx convex env set NAME value`.
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
# CONVEX_INBOUND_SECRET=

# Optional: an existing Clerk user for the signed-in end-to-end tests.
# They create and delete a tool on your dev deployment. Without this, they are skipped.
E2E_USER_EMAIL=
