# Encrypts n8n credentials at rest. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Public URL n8n advertises for webhooks. Use your tunnel URL if Convex runs in the cloud.
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Your deployment's HTTP actions URL: NEXT_PUBLIC_CONVEX_SITE_URL in .env.local.
CONVEX_SITE_URL=

# Must match the values set with `npx convex env set`. Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=
CONVEX_INBOUND_SECRET=
